# Copy to .env and fill in what you use. Everything is optional — the app
# runs fully offline without any of these.

# --- Claude recommendations (optional) --------------------------------------
# Enables the narrative recommendation layer on the Recommendations page.
# The deterministic rules engine works without it.
ANTHROPIC_API_KEY=
# Override the model (default: claude-opus-5). Can also be set in Settings.
ANTHROPIC_MODEL=

# --- Meta Marketing API sync (optional) -------------------------------------
# Enables one-click sync on the Import page. Requires a system-user access
# token with ads_read for the ad account. Without these, use CSV import.
META_ACCESS_TOKEN=
# The ad account id, with or without the act_ prefix (e.g. act_1234567890).
META_AD_ACCOUNT_ID=
# Graph API version (default: v23.0).
META_API_VERSION=

# --- Storage (optional) -----------------------------------------------------
# Where the SQLite database and uploaded creatives live (default: ./data).
DATA_DIR=
